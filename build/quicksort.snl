program QuickSort

type
    IntArray = array [1..100] of integer;

var
    IntArray a;
    integer n, i;

procedure sort(var IntArray arr; integer left, right);
var
    integer i, j, pivot, temp;
begin
    i := left;
    j := right;
    pivot := arr[(left + right) / 2];

    while i < j do
        while arr[i] < pivot do
            i := i + 1
        endwh;

        while pivot < arr[j] do
            j := j - 1
        endwh;

        if i < j then
            temp := arr[i];
            arr[i] := arr[j];
            arr[j] := temp;
            i := i + 1;
            j := j - 1
        else
            if i = j then
                i := i + 1;
                j := j - 1
            else
                temp := temp
            fi
        fi
    endwh;

    if left < j then
        sort(arr, left, j)
    else
        temp := temp
    fi;

    if i < right then
        sort(arr, i, right)
    else
        temp := temp
    fi;

    return
end

begin
    read(n);

    i := 1;
    while i < n do
        read(a[i]);
        i := i + 1
    endwh;
    read(a[n]);

    sort(a, 1, n);

    i := 1;
    while i < n do
        write(a[i]);
        i := i + 1
    endwh;
    write(a[n])
end.